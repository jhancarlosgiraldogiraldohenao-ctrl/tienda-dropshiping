{{ 'vx-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vx-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--vx-asfalto);
  }
  #shopify-section-{{ section.id }} .vx-porque__cabecera { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .vx-porque__cabecera h2 { font-size: clamp({{ section.settings.titulo_size | times: 0.55 | round }}px, 6vw, {{ section.settings.titulo_size }}px); }
  #shopify-section-{{ section.id }} .vx-porque__card p { font-size: {{ section.settings.texto_size }}px; }
{% endstyle %}

<section class="vx-section vx-porque">
  <div class="vx-container">
    <div class="vx-porque__cabecera">
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow vx-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-reveal" style="--vx-i:1">{{ section.settings.titulo }}{% if section.settings.titulo_acento != blank %} <span class="vx-acento">{{ section.settings.titulo_acento }}</span>{% endif %}</h2>
      {%- if section.settings.texto != blank -%}<p class="vx-reveal" style="--vx-i:2">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="vx-porque__grid">
      {%- for block in section.blocks -%}
        <article class="vx-porque__card vx-reveal" style="--vx-i:{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="vx-porque__icono">{% render 'vx-icono', nombre: block.settings.icono %}</span>
          <h3>{{ block.settings.titulo }}</h3>
          <p>{{ block.settings.texto | newline_to_br }}</p>
          {%- if block.settings.dato != blank -%}<span class="vx-porque__dato">{{ block.settings.dato }}</span>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.franja != blank -%}
      <div class="vx-porque__franja vx-reveal">
        {% render 'vx-icono', nombre: 'escudo' %}
        <p>{{ section.settings.franja }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VX – Por qué comprar aquí",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Compra sin riesgo" },
    { "type": "text", "id": "titulo", "label": "Título (parte blanca)", "default": "¿Por qué comprar en" },
    { "type": "text", "id": "titulo_acento", "label": "Título (parte amarilla)", "default": "Vuronix?" },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "textarea", "id": "franja", "label": "Frase final destacada" },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "alineacion", "label": "Alineación del encabezado", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "center" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 28, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "razon",
      "name": "Razón",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "options": [
          { "value": "camion", "label": "Envío" }, { "value": "efectivo", "label": "Efectivo" }, { "value": "escudo", "label": "Garantía" },
          { "value": "reloj", "label": "Reloj" }, { "value": "medidor", "label": "Medidor" }, { "value": "rayo", "label": "Rayo" }, { "value": "check", "label": "Check" }
        ], "default": "check" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Razón" },
        { "type": "textarea", "id": "texto", "label": "Texto" },
        { "type": "text", "id": "dato", "label": "Dato destacado (opcional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "VX – Por qué comprar aquí", "blocks": [ { "type": "razon" } ] } ]
}
{% endschema %}
