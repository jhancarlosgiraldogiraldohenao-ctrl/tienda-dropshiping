{{ 'vx-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vx-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo }};
  }
  #shopify-section-{{ section.id }} .vx-anatomia { background: {{ section.settings.fondo }}; }
  #shopify-section-{{ section.id }} h2 { font-size: clamp({{ section.settings.titulo_size | times: 0.55 | round }}px, 6vw, {{ section.settings.titulo_size }}px); }
  #shopify-section-{{ section.id }} .vx-anatomia__cabecera p { font-size: {{ section.settings.texto_size }}px; }
  #shopify-section-{{ section.id }} .vx-anatomia__foto { max-width: {{ section.settings.foto_ancho }}px; margin-inline: auto; }
{% endstyle %}

<section class="vx-section vx-anatomia" data-vx-anatomia>
  <div class="vx-container">
    <div class="vx-anatomia__cabecera">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow vx-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="vx-reveal" style="--vx-i:1; margin-top: 16px">{{ section.settings.titulo }}</h2>
      </div>
      {%- if section.settings.texto != blank -%}<p class="vx-reveal" style="--vx-i:2">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="vx-anatomia__escena">
      <div class="vx-anatomia__lista vx-anatomia__lista--izq">
        {%- for block in section.blocks -%}
          {%- if block.settings.lado == 'izq' -%}
            <div class="vx-punto-info vx-reveal vx-reveal--izq" style="--vx-i:{{ forloop.index }}" data-vx-punto="{{ block.id }}" tabindex="0" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.titulo }} <b>{{ forloop.index }}</b></h3>
              <p>{{ block.settings.texto }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="vx-anatomia__foto vx-reveal vx-reveal--zoom">
        {%- if section.settings.imagen != blank -%}
          <img src="{{ section.settings.imagen | image_url: width: 1000 }}" alt="{{ section.settings.imagen.alt | escape }}" width="{{ section.settings.imagen.width }}" height="{{ section.settings.imagen.height }}" loading="lazy">
        {%- else -%}
          <img src="{{ 'vx-estudio-frente.jpg' | asset_url }}" alt="Inflador Vuronix AirGo de frente" width="700" height="1254" loading="lazy">
        {%- endif -%}
        {%- for block in section.blocks -%}
          <button type="button" class="vx-hotspot" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%" data-vx-punto="{{ block.id }}" aria-label="{{ block.settings.titulo | escape }}">{{ forloop.index }}</button>
        {%- endfor -%}
      </div>

      <div class="vx-anatomia__lista vx-anatomia__lista--der">
        {%- for block in section.blocks -%}
          {%- if block.settings.lado == 'der' -%}
            <div class="vx-punto-info vx-reveal vx-reveal--der" style="--vx-i:{{ forloop.index }}" data-vx-punto="{{ block.id }}" tabindex="0" {{ block.shopify_attributes }}>
              <h3><b>{{ forloop.index }}</b> {{ block.settings.titulo }}</h3>
              <p>{{ block.settings.texto }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX – Anatomía",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Diseñado al detalle" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Todo lo que necesitas, en 480 gramos" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Pasa el cursor o toca cada número para conocer cada parte." },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "imagen", "label": "Foto del producto (mejor con fondo claro)" },
    { "type": "range", "id": "foto_ancho", "label": "Ancho máximo de la foto (px)", "min": 240, "max": 640, "step": 10, "unit": "px", "default": 420 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#EEF0F2" },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 28, "max": 100, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Punto",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Pantalla digital" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Lectura clara de la presión." },
        { "type": "select", "id": "lado", "label": "Tarjeta a la", "options": [ { "value": "izq", "label": "Izquierda" }, { "value": "der", "label": "Derecha" } ], "default": "izq" },
        { "type": "range", "id": "x", "label": "Posición horizontal del punto (%)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Posición vertical del punto (%)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "VX – Anatomía", "blocks": [ { "type": "punto" } ] } ]
}
{% endschema %}
