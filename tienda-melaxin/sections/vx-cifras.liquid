{{ 'vx-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vx-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--vx-grafito);
  }
  #shopify-section-{{ section.id }} .vx-cifra__valor { font-size: clamp({{ section.settings.valor_size | times: 0.55 | round }}px, 6vw, {{ section.settings.valor_size }}px); }
  #shopify-section-{{ section.id }} .vx-cifra__texto { font-size: {{ section.settings.texto_size }}px; }
  #shopify-section-{{ section.id }} .vx-cifra { text-align: {{ section.settings.alineacion }}; }
{% endstyle %}

<section class="vx-section vx-cifras">
  <div class="vx-container">
    <div class="vx-cifras__grid">
      {%- for block in section.blocks -%}
        <div class="vx-cifra" {{ block.shopify_attributes }}>
          <div class="vx-cifra__valor vx-lcd"><span data-vx-count="{{ block.settings.valor }}" data-vx-dec="{{ block.settings.decimales }}" data-vx-prefijo="{{ block.settings.prefijo | escape }}">{{ block.settings.prefijo }}0</span><small>{{ block.settings.unidad }}</small></div>
          <div class="vx-cifra__label">{{ block.settings.titulo }}</div>
          {%- if block.settings.texto != blank -%}<p class="vx-cifra__texto">{{ block.settings.texto }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX – Cifras",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "alineacion", "label": "Alineación", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "range", "id": "valor_size", "label": "Tamaño de las cifras (px)", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 84 },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "cifra",
      "name": "Cifra",
      "settings": [
        { "type": "text", "id": "prefijo", "label": "Antes del número (ej. ±)" },
        { "type": "number", "id": "valor", "label": "Número", "default": 150 },
        { "type": "range", "id": "decimales", "label": "Decimales", "min": 0, "max": 2, "step": 1, "default": 0 },
        { "type": "text", "id": "unidad", "label": "Unidad", "default": "PSI" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Presión máxima" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "De sobra para moto, carro y bici." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "VX – Cifras", "blocks": [ { "type": "cifra" }, { "type": "cifra" }, { "type": "cifra" }, { "type": "cifra" } ] } ]
}
{% endschema %}
