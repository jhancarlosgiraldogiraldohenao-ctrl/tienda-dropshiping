{{ 'vx-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vx-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--vx-asfalto);
  }
  #shopify-section-{{ section.id }} .vx-comparativa__cabecera { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .vx-comparativa__cabecera h2 { font-size: clamp({{ section.settings.titulo_size | times: 0.55 | round }}px, 6vw, {{ section.settings.titulo_size }}px); }
  #shopify-section-{{ section.id }} .vx-comparativa__cabecera p { font-size: {{ section.settings.texto_size }}px; color: var(--vx-texto-suave); margin-top: 14px; }
  #shopify-section-{{ section.id }} .vx-tabla > div:not(.vx-tabla__cab) { font-size: {{ section.settings.tabla_size }}px; }
  {%- if section.settings.alineacion == 'left' -%}#shopify-section-{{ section.id }} .vx-comparativa__cabecera { margin-left: 0; } #shopify-section-{{ section.id }} .vx-comparativa__cabecera .vx-eyebrow { justify-content: flex-start; }{%- endif -%}
{% endstyle %}

<section class="vx-section vx-comparativa">
  <div class="vx-container">
    <div class="vx-comparativa__cabecera">
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow vx-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-reveal" style="--vx-i:1">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="vx-reveal" style="--vx-i:2">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="vx-tabla vx-reveal" style="--vx-i:3" role="table">
      <div class="vx-tabla__cab" role="columnheader">{{ section.settings.col_criterio }}</div>
      <div class="vx-tabla__cab vx-tabla__nos" role="columnheader">{% render 'vx-icono', nombre: 'rayo' %}{{ section.settings.col_nos }}</div>
      <div class="vx-tabla__cab vx-tabla__ellos" role="columnheader">{{ section.settings.col_ellos }}</div>
      {%- for block in section.blocks -%}
        <div role="cell" {{ block.shopify_attributes }}><strong>{{ block.settings.criterio }}</strong></div>
        <div class="vx-tabla__nos" role="cell">{% if block.settings.nos_ok %}{% render 'vx-icono', nombre: 'check' %}{% else %}{% render 'vx-icono', nombre: 'x' %}{% endif %}{{ block.settings.nos }}</div>
        <div class="vx-tabla__ellos" role="cell">{% if block.settings.ellos_ok %}{% render 'vx-icono', nombre: 'check' %}{% else %}{% render 'vx-icono', nombre: 'x' %}{% endif %}{{ block.settings.ellos }}</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX – Comparativa",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "La cuenta es fácil" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Tu inflador vs. la gasolinera" },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "text", "id": "col_criterio", "label": "Encabezado primera columna" },
    { "type": "text", "id": "col_nos", "label": "Encabezado de tu producto", "default": "AirGo" },
    { "type": "text", "id": "col_ellos", "label": "Encabezado de la alternativa", "default": "Gasolinera" },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "alineacion", "label": "Alineación del encabezado", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "center" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 28, "max": 100, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "tabla_size", "label": "Tamaño del texto de la tabla (px)", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "fila",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "criterio", "label": "Criterio", "default": "Disponible" },
        { "type": "text", "id": "nos", "label": "Tu producto", "default": "Siempre contigo" },
        { "type": "checkbox", "id": "nos_ok", "label": "Tu producto: positivo", "default": true },
        { "type": "text", "id": "ellos", "label": "Alternativa", "default": "Si está abierta" },
        { "type": "checkbox", "id": "ellos_ok", "label": "Alternativa: positivo", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "VX – Comparativa", "blocks": [ { "type": "fila" } ] } ]
}
{% endschema %}
