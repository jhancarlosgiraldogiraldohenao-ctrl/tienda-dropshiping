{%- comment -%}
  Fecha límite de entrega. Única fuente: Configuración del tema → Toffee – Fechas y garantía.
  Cada línea: AAAA-MM-DD|noche|emoji|países (opcional: CO = solo Colombia, US = solo EE. UU., -US = todos menos EE. UU.).
  render 'tf-corte'              → la próxima fecha que aplica al país del visitante
  render 'tf-corte', lista: true → todas las fechas vigentes de ese país
  El servidor la calcula con la fecha de hoy; hl-scripts.js la recalcula en el navegador por si la página quedó en caché.
{%- endcomment -%}
{%- liquid
  assign meses = 'enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre' | split: ','
  assign hoy = 'now' | date: '%Y%m%d' | plus: 0
  assign pais = localization.country.iso_code | default: 'CO'
  assign buscar = ',' | append: pais | append: ','
  assign lineas = settings.tf_cortes | newline_to_br | split: '<br />'
  assign hay = false
-%}
{%- capture frase -%}{{ settings.tf_corte_vencido }}{%- endcapture -%}
{%- capture filas -%}
  {%- for l in lineas -%}
    {%- assign p = l | strip | split: '|' -%}
    {%- if p.size < 2 -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign aplica = true
      assign regla = p[3] | strip | remove: ' '
      if regla != blank
        assign excluye = false
        if regla contains '-'
          assign excluye = true
          assign regla = regla | remove: '-'
        endif
        assign con = ',' | append: regla | append: ','
        if excluye and con contains buscar
          assign aplica = false
        elsif excluye == false and con contains buscar
          assign aplica = true
        elsif excluye == false
          assign aplica = false
        endif
      endif
    -%}
    {%- unless aplica -%}{%- continue -%}{%- endunless -%}
    {%- assign fecha = p[0] | strip -%}
    {%- assign num = fecha | remove: '-' | plus: 0 -%}
    {%- assign partes = fecha | split: '-' -%}
    {%- assign m = partes[1] | plus: 0 | minus: 1 -%}
    <span class="tf-cortes__fila" data-corte="{{ fecha }}" data-paises="{{ p[3] | strip | remove: ' ' }}"{% if num < hoy %} hidden{% endif %}><span>{{ p[2] | strip }} Para {{ p[1] | strip }}</span><b>Pide hasta el {{ partes[2] | plus: 0 }} de {{ meses[m] }}</b></span>
    {%- if num >= hoy and hay == false -%}
      {%- assign hay = true -%}
      {%- capture frase -%}{{ p[2] | strip }} Para {{ p[1] | strip }}, pide hasta el <b>{{ partes[2] | plus: 0 }} de {{ meses[m] }}</b>{%- endcapture -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if lista -%}
  <span class="tf-cortes" data-tf-cortes>{{ filas }}<span class="tf-cortes__fila" data-corte-vencido{% if hay %} hidden{% endif %}><span>{{ settings.tf_corte_vencido }}</span></span></span>
{%- else -%}
  <span class="tf-corte" data-tf-corte>{{ frase }}</span>
{%- endif -%}
