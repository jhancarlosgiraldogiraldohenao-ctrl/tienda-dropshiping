{%- comment -%} Datos de entrega para hl-scripts.js (fechas límite, días hábiles y festivos). Se carga una vez en theme.liquid. {%- endcomment -%}
{%- liquid
  assign lineas = settings.tf_cortes | newline_to_br | split: '<br />'
  assign festivos = settings.tf_festivos | newline_to_br | split: '<br />'
-%}
<script type="application/json" id="tf-fechas">{"min":{{ settings.tf_dias_min | default: 10 }},"max":{{ settings.tf_dias_max | default: 25 }},"vencido":{{ settings.tf_corte_vencido | json }},"festivos":[{%- assign coma = false -%}{%- for f in festivos -%}{%- assign t = f | strip -%}{%- if t != blank -%}{% if coma %},{% endif %}{{ t | json }}{%- assign coma = true -%}{%- endif -%}{%- endfor -%}],"cortes":[{%- assign coma = false -%}{%- for l in lineas -%}{%- assign p = l | strip | split: '|' -%}{%- if p.size >= 2 -%}{% if coma %},{% endif %}{"f":{{ p[0] | strip | json }},"n":{{ p[1] | strip | json }},"e":{{ p[2] | strip | json }}}{%- assign coma = true -%}{%- endif -%}{%- endfor -%}]}</script>
