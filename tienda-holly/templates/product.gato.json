        "b4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué tamaño tiene?",
            "respuesta": "<p>50 cm de ancho × 50 cm de fondo × 60 cm de alto. Ideal para gatos y perritos pequeños. Para perros medianos o grandes es muy pequeña.</p>"
