{{ 'hl-styles.css' | asset_url | stylesheet_tag }}
{%- comment -%} Pie A: marino, menús editables (Tienda online > Navegación), Libro de Reclamaciones, SIC y aviso de IA. {%- endcomment -%}
<footer class="tf-pie">
  <div class="hl-container">
    <div class="tf-pie__top">
      <div class="tf-pie__marca">
        <a class="hl-wordmark" href="{{ routes.root_url }}"><img class="tf-avatar" src="{{ 'tf-avatar.jpg' | asset_url }}" alt="" width="80" height="80" loading="lazy">{{ shop.name }}</a>
        {%- if section.settings.frase != blank -%}<p>{{ section.settings.frase }}</p>{%- endif -%}
        <p class="tf-pie__contacto">{{ section.settings.contacto }}</p>
        <div class="tf-pie__redes">
          {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'hl-icono', nombre: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'hl-icono', nombre: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" aria-label="YouTube" target="_blank" rel="noopener">{% render 'hl-icono', nombre: 'youtube' %}</a>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'hl-icono', nombre: 'facebook' %}</a>{%- endif -%}
        </div>
      </div>
      {%- for i in (1..3) -%}
        {%- assign k = 'menu_' | append: i -%}{%- assign kt = 'titulo_' | append: i -%}
        {%- assign menu = linklists[section.settings[k]] -%}
        {%- if menu.links.size > 0 -%}
          <nav class="tf-pie__col" aria-label="{{ section.settings[kt] | escape }}">
            <h2>{{ section.settings[kt] }}</h2>
            <ul>{%- for l in menu.links -%}<li><a href="{{ l.url }}">{{ l.title }}</a></li>{%- endfor -%}</ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="tf-pie__oficial">
      <a class="tf-pie__libro" href="{{ routes.root_url }}pages/libro-de-reclamaciones">
        <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><rect x="7" y="5" width="26" height="31" rx="3" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 5v31" stroke="currentColor" stroke-width="2.2"/><path d="M17 13h11M17 18h11M17 23h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span><b>Libro de Reclamaciones</b><small>Perú · hoja de reclamación virtual</small></span>
      </a>
      <a class="tf-pie__libro" href="https://www.sic.gov.co" target="_blank" rel="noopener">
        <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4 6 10v9c0 8.5 6 14.5 14 17 8-2.5 14-8.5 14-17v-9z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="m14 20 4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><b>Superintendencia de Industria y Comercio</b><small>Colombia · sic.gov.co</small></span>
      </a>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="tf-pie__pagos" role="list" aria-label="Medios de pago">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <p class="tf-pie__base">{{ section.settings.copyright }}</p>
  </div>
</footer>
{% schema %}
{
  "name": "Toffee – Pie de página",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "frase", "label": "Frase", "default": "La tienda para mascotas donde todo pasa por mi prueba primero. — Toffee 🐾" },
    { "type": "text", "id": "contacto", "label": "Contacto", "default": "soytoffee.store@gmail.com · atención solo por correo" },
    { "type": "text", "id": "titulo_1", "label": "Título columna 1", "default": "Tienda" },
    { "type": "link_list", "id": "menu_1", "label": "Menú columna 1", "default": "footer" },
    { "type": "text", "id": "titulo_2", "label": "Título columna 2", "default": "Ayuda" },
    { "type": "link_list", "id": "menu_2", "label": "Menú columna 2" },
    { "type": "text", "id": "titulo_3", "label": "Título columna 3", "default": "Legal" },
    { "type": "link_list", "id": "menu_3", "label": "Menú columna 3" },
    { "type": "text", "id": "copyright", "label": "Texto final", "default": "© 2026 Soy Toffee. Toffee y Galleta son personajes creados con IA. Los productos y la atención son reales." }
  ]
}
{% endschema %}
