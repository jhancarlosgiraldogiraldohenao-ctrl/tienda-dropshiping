{{ 'hl-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign variante = product.selected_or_first_available_variant -%}
{%- assign form_id = 'hl-form-' | append: section.id -%}

{% style %}
  #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .hl-compra__titulo { font-size: clamp({{ section.settings.titulo_size | times: 0.62 | round }}px, 3.6vw, {{ section.settings.titulo_size }}px); }
  #shopify-section-{{ section.id }} .hl-compra__intro, #shopify-section-{{ section.id }} .hl-compra__puntos li { font-size: {{ section.settings.texto_size }}px; }
{% endstyle %}

<script type="application/ld+json">{{ product | structured_data }}</script>
<section class="hl-section hl-producto">
  <div class="hl-container">
    <div class="hl-producto__grid">
      <div class="hl-galeria" data-hl-galeria>
        {%- assign primera = variante.featured_media | default: product.featured_media -%}
        {%- assign id_uno = product.variants[0].featured_media.id -%}
        {%- assign id_pack = product.variants[1].featured_media.id -%}
        {%- if variante.id == product.variants[1].id -%}{%- assign modo = 'pack' -%}{%- else -%}{%- assign modo = 'uno' -%}{%- endif -%}
        <div class="hl-galeria__principal">
          {%- if section.settings.sello != blank -%}<span class="hl-galeria__sello">{{ section.settings.sello }}</span>{%- endif -%}
          <span class="tf-chip-ia" data-tf-chip{% unless primera.alt contains '(escena IA)' %} hidden{% endunless %}>Escena creada con IA</span>
          {%- if primera -%}
            <img src="{{ primera | image_url: width: 900 }}" srcset="{{ primera | image_url: width: 600 }} 600w, {{ primera | image_url: width: 900 }} 900w, {{ primera | image_url: width: 1200 }} 1200w" sizes="(min-width: 990px) 50vw, 100vw" alt="{{ primera.alt | default: product.title | remove: ' (escena IA)' | escape }}" width="1024" height="1280" loading="eager" fetchpriority="high">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 and section.settings.mostrar_miniaturas -%}
          <div class="hl-galeria__mins" data-modo="{{ modo }}">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                {%- liquid
                  assign grupo = 'todos'
                  if section.settings.modo_colores
                  elsif product.variants.size > 1 and media.id == id_pack
                    assign grupo = 'pack'
                  elsif product.variants.size > 1
                    assign grupo = 'uno'
                  endif
                -%}
                <button type="button" class="hl-galeria__min{% if media.id == primera.id %} is-activo{% endif %}" data-grupo="{{ grupo }}"{% if grupo != 'todos' and grupo != modo %} hidden{% endif %} data-src="{{ media | image_url: width: 900 }}" data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w" data-alt="{{ media.alt | default: product.title | remove: ' (escena IA)' | escape }}" data-ia="{% if media.alt contains '(escena IA)' %}1{% endif %}" aria-label="Ver foto {{ forloop.index }}">
                  <img src="{{ media | image_url: width: 180 }}" alt="" loading="lazy" width="90" height="90">
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hl-compra" data-hl-compra>
        {%- if section.settings.eyebrow != blank -%}<span class="tf-aprobado">{% render 'hl-icono', nombre: 'check' %}{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="hl-compra__titulo">{{ section.settings.titulo_corto | default: product.title }}</h1>
        {%- if section.settings.subtitulo != blank -%}<p class="hl-compra__estrellas">{{ section.settings.subtitulo }}</p>{%- endif -%}
        {%- if section.settings.frase_toffee != blank -%}<p class="tf-frase-toffee">“{{ section.settings.frase_toffee }}” <span>{{ section.settings.frase_firma | default: '— Toffee' }}</span></p>{%- endif -%}
        {%- assign v1 = product.variants.first -%}
        <div class="hl-precio{% if section.settings.compra_rapida %} tf-precio-corto{% endif %}" data-hl-precio-bloque>
          <strong data-hl-precio>{{ variante.price | money_without_trailing_zeros }}</strong><span class="tf-moneda">{{ cart.currency.iso_code }}</span>
          <s data-hl-antes{% unless variante.compare_at_price > variante.price %} hidden{% endunless %}>{{ variante.compare_at_price | money_without_trailing_zeros }}</s>
          <span class="hl-precio__pct" data-hl-pct{% unless variante.compare_at_price > variante.price %} hidden{% endunless %}>-{{ variante.compare_at_price | minus: variante.price | times: 100.0 | divided_by: variante.compare_at_price | round }}%</span>
          {%- if section.settings.nota_precio != blank -%}<span class="hl-precio__nota">{{ section.settings.nota_precio }}</span>{%- endif -%}
        </div>

        {%- unless product.has_only_default_variant -%}
          {%- if section.settings.modo_pildoras -%}
            <div class="tf-opciones" data-tf-opciones>
              {%- for opt in product.options_with_values -%}
                {%- if opt.values.size > 1 -%}
                  <div class="tf-opcion" data-tf-opcion="{{ forloop.index0 }}">
                    <p class="hl-ofertas__titulo">{{ opt.name }}: <b data-tf-elegido>{{ opt.selected_value }}</b></p>
                    <div class="tf-pildoras">
                      {%- for val in opt.values -%}
                        <button type="button" class="tf-pildora{% if val == opt.selected_value %} is-activa{% endif %}" data-tf-valor="{{ val | escape }}" aria-pressed="{% if val == opt.selected_value %}true{% else %}false{% endif %}">{{ val }}</button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="tf-opcion" data-tf-opcion="{{ forloop.index0 }}" hidden><button type="button" class="tf-pildora is-activa" data-tf-valor="{{ opt.values.first | escape }}"></button></div>
                {%- endif -%}
              {%- endfor -%}
              {%- if section.settings.guia_tallas != blank -%}<p class="tf-guia-link"><a href="#guia-tallas">{{ section.settings.guia_tallas }}</a> · <a href="{{ routes.root_url }}pages/test-de-toffee">Haz el test de Toffee</a></p>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="hl-ofertas{% if section.settings.modo_pildoras %} tf-oculto{% endif %}" role="radiogroup" aria-label="{{ product.options.first | escape }}">
            {%- if section.settings.ofertas_titulo != blank -%}<p class="hl-ofertas__titulo">{{ section.settings.ofertas_titulo }}</p>{%- endif -%}
            {%- for v in product.variants -%}
              {%- liquid
                if v.featured_image
                  assign img_url = v.featured_image | image_url: width: 900
                else
                  assign img_url = product.featured_media | image_url: width: 900
                endif
                assign normal = v1.price | times: forloop.index
                assign ahorro = normal | minus: v.price
                if section.settings.modo_colores
                  assign nota = ''
                  assign ahorro = 0
                elsif forloop.first
                  assign nota = section.settings.oferta_1_nota
                else
                  assign nota = section.settings.oferta_2_nota
                endif
              -%}
              <label class="hl-oferta{% if v.id == variante.id %} is-activa{% endif %}">
                <input type="radio" name="hl-oferta-{{ section.id }}" value="{{ v.id }}" data-hl-oferta data-tf-opts="{{ v.options | join: '|' | escape }}" data-price="{{ v.price | money_without_trailing_zeros | escape }}" data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}" data-pct="{% if v.compare_at_price > v.price %}-{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}%{% endif %}" data-img="{{ img_url }}" {% if v.id == variante.id %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                <span class="hl-oferta__radio" aria-hidden="true"></span>
                <span class="hl-oferta__txt">
                  <strong>{{ v.title }}</strong>
                  {%- if nota != blank -%}<small>{{ nota }}</small>{%- endif -%}
                </span>
                <span class="hl-oferta__precio">
                  <strong>{{ v.price | money_without_trailing_zeros }}</strong>
                  {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
                </span>
                {%- if ahorro > 0 -%}
                  <span class="hl-oferta__badge">{{ section.settings.texto_ahorro }} {{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}%</span>
                {%- elsif forloop.first and section.settings.oferta_1_etiqueta != blank and section.settings.modo_colores == false -%}
                  <span class="hl-oferta__badge hl-oferta__badge--suave">{{ section.settings.oferta_1_etiqueta }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- capture intro_puntos -%}
        {%- if section.settings.intro != blank -%}<p class="hl-compra__intro">{{ section.settings.intro | newline_to_br }}</p>{%- endif -%}
        {%- if section.settings.puntos != blank -%}
          <ul class="hl-compra__puntos">
            {%- assign puntos = section.settings.puntos | newline_to_br | split: '<br />' -%}
            {%- for p in puntos -%}{%- assign t = p | strip -%}{%- if t != blank -%}<li>{% render 'hl-icono', nombre: 'check' %}<span>{{ t }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- endcapture -%}
        {%- unless section.settings.compra_rapida -%}{{ intro_puntos }}{%- endunless -%}

        <div class="hl-compra__form{% if section.settings.compra_rapida %} tf-compra-rapida{% endif %}">
          <product-form class="product-form" data-section-id="{{ section.id }}">
            <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
            {%- form 'product', product, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ variante.id }}" class="product-variant-id">
              <div class="hl-compra__fila">
                <div class="hl-cantidad">
                  <button type="button" data-hl-cant="-1" aria-label="Menos">−</button>
                  <input type="number" name="quantity" value="1" min="1" aria-label="Cantidad">
                  <button type="button" data-hl-cant="1" aria-label="Más">+</button>
                </div>
                <button type="submit" name="add" class="hl-btn {% if section.settings.compra_rapida %}hl-btn--curcuma tf-btn-agregar{% else %}hl-btn--ghost{% endif %} product-form__submit" {% unless variante.available %}disabled{% endunless %}>
                  <span>{% if variante.available %}{{ section.settings.carrito_texto }}{% if section.settings.compra_rapida %} · <b data-hl-precio>{{ variante.price | money_without_trailing_zeros }}</b>{% endif %}{% else %}{{ section.settings.agotado_texto }}{% endif %}</span>
                  <div class="loading__spinner hidden"><svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg></div>
                </button>
              </div>
            {%- endform -%}
          </product-form>
          <a class="hl-btn {% if section.settings.compra_rapida %}hl-btn--ghost{% else %}hl-btn--curcuma{% endif %} hl-compra__ahora" data-hl-comprar href="{{ routes.cart_url }}/{{ variante.id }}:1"{% unless variante.available %} aria-disabled="true"{% endunless %}>{%- if section.settings.compra_rapida -%}{{ section.settings.comprar_texto }} {% render 'hl-icono', nombre: 'flecha' %}{%- else -%}{{ section.settings.comprar_texto }} {% render 'hl-icono', nombre: 'flecha' %}{%- endif -%}</a>
          {%- if section.settings.compra_rapida -%}{% render 'tf-precio-local', precio: variante.price %}{%- endif -%}
          {%- if section.settings.comprar_nota != blank -%}<p class="hl-compra__nota-ahora">{% render 'hl-icono', nombre: 'candado' %}{{ section.settings.comprar_nota }}</p>{%- endif -%}
          {%- if section.settings.compra_rapida -%}
            <div class="tf-extra">
              <p class="tf-entrega" data-tf-entrega>📦 Envío gratis · llega en {{ settings.tf_dias_min }} a {{ settings.tf_dias_max }} días hábiles</p>
              {% render 'tf-aviso-impuestos' %}
              <p class="tf-navidad">{% render 'tf-corte' %}</p>
              <div class="tf-pagos" aria-label="Medios de pago">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'tf-pago' }}{%- endfor -%}</div>
            </div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="hl-confianza">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>{% render 'hl-icono', nombre: block.settings.icono %}<strong>{{ block.settings.titulo }}</strong>{{ block.settings.texto }}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.marrano_linea -%}
          {%- assign aporte = variante.price | times: 0.03 | round -%}
          <p class="tf-marrano-linea"><a href="{{ section.settings.marrano_url | default: '/pages/marrano' }}">🐷 Con esta compra, <b>{{ aporte | money_without_trailing_zeros }}</b> van al marrano de Toffee</a></p>
        {%- endif -%}

        {%- if section.settings.compra_rapida -%}<div class="tf-compra-info">{{ intro_puntos }}</div>{%- endif -%}

        {%- if section.settings.veredicto != blank -%}
          <div class="tf-veredicto">
            <div class="tf-veredicto__cabeza">{% render 'tf-sello', texto: 'Aprobado', clase: 'tf-sello--inline' %}<div><span class="hl-eyebrow">{{ section.settings.veredicto_titulo | default: 'La opinión de Toffee' }}</span><p class="tf-veredicto__rotulo">{{ section.settings.veredicto_rotulo }}</p></div></div>
            <ul>
              {%- assign filas = section.settings.veredicto | newline_to_br | split: '<br />' -%}
              {%- for f in filas -%}{%- assign par = f | strip | split: '|' -%}{%- if par[0] != blank -%}<li><span>{{ par[0] }}</span><b>{{ par[1] }}</b></li>{%- endif -%}{%- endfor -%}
            </ul>
            {%- if section.settings.nota_toffee != blank -%}<p class="tf-nota-toffee"><span>Nota de Toffee</span>{{ section.settings.nota_toffee }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.tabla_tallas != blank -%}
          <div class="tf-tallas" id="guia-tallas">
            <h2>{{ section.settings.tallas_titulo }}</h2>
            {%- if section.settings.tallas_nota != blank -%}<p>{{ section.settings.tallas_nota }}</p>{%- endif -%}
            <div class="tf-tallas__scroll"><table>
              {%- assign filas = section.settings.tabla_tallas | newline_to_br | split: '<br />' -%}
              {%- for f in filas -%}{%- assign celdas = f | strip | split: '|' -%}{%- if celdas[0] != blank -%}
                <tr>{%- for c in celdas -%}{%- if forloop.parentloop.first -%}<th scope="col">{{ c }}</th>{%- elsif forloop.first -%}<th scope="row">{{ c }}</th>{%- else -%}<td>{{ c }}</td>{%- endif -%}{%- endfor -%}</tr>
              {%- endif -%}{%- endfor -%}
            </table></div>
          </div>
        {%- endif -%}
        {%- if section.settings.aviso != blank -%}<p class="tf-aviso">{% render 'hl-icono', nombre: 'escudo' %}<span>{{ section.settings.aviso }}</span></p>{%- endif -%}

        <div class="hl-desc">
          {%- if product.description != blank -%}
            <details{% if section.settings.abrir_descripcion %} open{% endif %}>
              <summary>{{ section.settings.desc_titulo }}</summary>
              <div class="hl-desc__cuerpo">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.envio != blank -%}
            <details>
              <summary>{{ section.settings.envio_titulo }}</summary>
              {%- assign envio = section.settings.envio | newline_to_br -%}
              {%- if envio contains '[fecha-limite]' -%}{%- capture corte -%}{% render 'tf-corte' %}{%- endcapture -%}{%- assign envio = envio | replace: '[fecha-limite]', corte -%}{%- endif -%}
              <div class="hl-desc__cuerpo">{{ envio }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.modo_pildoras -%}
  <script>
    (function () {
      var caja = document.querySelector('#shopify-section-{{ section.id }} [data-tf-opciones]');
      if (!caja) return;
      var compra = caja.closest('[data-hl-compra]');
      caja.querySelectorAll('.tf-pildora').forEach(function (b) {
        b.addEventListener('click', function () {
          var grupo = b.closest('[data-tf-opcion]');
          grupo.querySelectorAll('.tf-pildora').forEach(function (x) { x.classList.toggle('is-activa', x === b); x.setAttribute('aria-pressed', x === b); });
          var el = grupo.querySelector('[data-tf-elegido]'); if (el) el.textContent = b.dataset.tfValor;
          var sel = []; caja.querySelectorAll('[data-tf-opcion]').forEach(function (g) { var a = g.querySelector('.tf-pildora.is-activa'); sel.push(a ? a.dataset.tfValor : ''); });
          var clave = sel.join('|');
          compra.querySelectorAll('[data-hl-oferta]').forEach(function (r) {
            if (r.dataset.tfOpts === clave && !r.checked) { r.checked = true; r.dispatchEvent(new Event('change')); }
          });
        });
      });
    })();
  </script>
  {%- endif -%}


  <script>
    (function () {
      var g = document.querySelector('#shopify-section-{{ section.id }} [data-hl-galeria]'); if (!g) return;
      var img = g.querySelector('.hl-galeria__principal img'), chip = g.querySelector('[data-tf-chip]'); if (!img || !chip) return;
      var base = function (u) { return (u || '').split('?')[0].split('/').pop(); };
      var revisar = function () { var b = base(img.getAttribute('src')), ia = false; g.querySelectorAll('.hl-galeria__min').forEach(function (m) { if (base(m.dataset.src) === b && m.dataset.ia) ia = true; }); chip.hidden = !ia; };
      new MutationObserver(revisar).observe(img, { attributes: true, attributeFilter: ['src'] });
    })();
  </script>

  <div class="hl-sticky-compra" data-hl-sticky-compra>
    <div><small>{{ section.settings.sticky_texto }}</small><strong data-hl-sticky-precio>{{ variante.price | money_without_trailing_zeros }}</strong></div>
    <a class="hl-btn hl-btn--curcuma" data-hl-comprar-sticky href="{{ routes.cart_url }}/{{ variante.id }}:1">{{ section.settings.comprar_corto }}</a>
  </div>
</section>

{% schema %}
{
  "name": "KF – Producto",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Dr. Melaxin · 200 ml"
    },
    {
      "type": "text",
      "id": "titulo_corto",
      "label": "Título visible (vacío = título del producto)",
      "default": "Peel Shot, spray exfoliante corporal"
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtítulo",
      "default": "Ácido kójico · Cúrcuma · Niacinamida · AHA + PHA"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción",
      "default": "Renueva la textura de tu piel y ayuda a mejorar visualmente el tono desigual. Rocías, esperas y enjuagas: llega fácil a espalda, codos y rodillas."
    },
    {
      "type": "text",
      "id": "nota_precio",
      "label": "Nota bajo el precio",
      "default": "Envío gratis · Pagas en efectivo al recibir"
    },
    {
      "type": "textarea",
      "id": "puntos",
      "label": "Puntos clave (uno por línea)",
      "default": "Piel con sensación más suave y lisa\nAyuda a unificar visualmente el tono\nFormato spray: sin frotar de más\n200 ml para varias semanas de uso"
    },
    {
      "type": "text",
      "id": "sello",
      "label": "Sello sobre la foto",
      "default": "Pagas al recibir"
    },
    {
      "type": "header",
      "content": "Opciones de compra"
    },
    {
      "type": "text",
      "id": "ofertas_titulo",
      "label": "Título de las opciones",
      "default": "Elige tu opción"
    },
    {
      "type": "text",
      "id": "oferta_1_nota",
      "label": "Opción 1 – texto pequeño",
      "default": "Para tu ritual"
    },
    {
      "type": "text",
      "id": "oferta_1_etiqueta",
      "label": "Opción 1 – etiqueta",
      "default": "-20%"
    },
    {
      "type": "text",
      "id": "oferta_2_nota",
      "label": "Opción 2 – texto pequeño",
      "default": "Uno para ti y otro para regalar"
    },
    {
      "type": "checkbox",
      "id": "modo_colores",
      "label": "Las opciones son colores (no packs)",
      "default": false
    },
    { "type": "text", "id": "frase_toffee", "label": "Frase de Toffee bajo el título" },
    { "type": "text", "id": "frase_firma", "label": "Firma de la frase", "default": "— Toffee, personaje de IA" },
    { "type": "text", "id": "veredicto_titulo", "label": "Título de la opinión de Toffee", "default": "La opinión de Toffee" },
    { "type": "text", "id": "veredicto_rotulo", "label": "Aviso bajo la opinión", "default": "Toffee es un personaje creado con IA: esto es su opinión de personaje, no una reseña de clientes." },
    { "type": "textarea", "id": "veredicto", "label": "Opinión de Toffee (Criterio|Nota, sin estrellas)" },
    { "type": "text", "id": "nota_toffee", "label": "Nota de Toffee (veredicto)" },
    { "type": "text", "id": "tallas_titulo", "label": "Título guía de tallas", "default": "Guía de tallas" },
    { "type": "text", "id": "tallas_nota", "label": "Nota guía de tallas" },
    { "type": "textarea", "id": "tabla_tallas", "label": "Tabla de tallas (columnas con |, primera fila = encabezado)" },
    { "type": "text", "id": "aviso", "label": "Aviso de seguridad" },
    {
      "type": "checkbox",
      "id": "compra_rapida",
      "label": "Compra rápida: botón con precio bajo las opciones",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Días de entrega, fechas límite y garantía: Configuración del tema → Toffee – Fechas y garantía."
    },
    {
