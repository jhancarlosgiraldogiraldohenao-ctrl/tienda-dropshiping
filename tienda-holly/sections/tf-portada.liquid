{{ 'hl-styles.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Portada de temporada: personaje + producto en uso + problema de la temporada + un solo botón.
  Pensada primero para el celular (390 px): foto arriba, texto y botón dentro del primer pantallazo.
{%- endcomment -%}
{%- assign p = section.settings.producto -%}
{%- assign v = p.selected_or_first_available_variant -%}

{% style %}
  #shopify-section-{{ section.id }} .tf-portada__titulo { font-size: clamp({{ section.settings.titulo_size | times: 0.5 | round }}px, 4.6vw, {{ section.settings.titulo_size }}px); }
{% endstyle %}

<section class="hl-section tf-portada tf-oscuro" id="{{ section.settings.ancla | default: 'temporada' }}" aria-label="{{ section.settings.eyebrow | escape }}">
  <div class="hl-container tf-portada__grid">
    <div class="tf-portada__foto">
      {%- if section.settings.imagen != blank -%}
        <img src="{{ section.settings.imagen | image_url: width: 900 }}"
          srcset="{{ section.settings.imagen | image_url: width: 500 }} 500w, {{ section.settings.imagen | image_url: width: 700 }} 700w, {{ section.settings.imagen | image_url: width: 900 }} 900w, {{ section.settings.imagen | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 990px) 46vw, 100vw" alt="{{ section.settings.imagen.alt | escape }}" width="1024" height="1024"{% if section.settings.es_h1 %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
      {%- elsif p.featured_media -%}
        <img src="{{ p.featured_media | image_url: width: 900 }}" alt="{{ p.title | escape }}" width="900" height="900"{% if section.settings.es_h1 %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
      {%- endif -%}
      {%- if section.settings.escena_ia -%}<span class="tf-chip-ia">Escena creada con IA</span>{%- endif -%}
      {%- if section.settings.sello != blank -%}{% render 'tf-sello', texto: section.settings.sello, clase: 'tf-portada__sello' %}{%- endif -%}
    </div>

    <div class="tf-portada__texto">
      {%- if section.settings.eyebrow != blank -%}<span class="tf-portada__kicker">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- liquid
        assign htag = 'h2'
        if section.settings.es_h1
          assign htag = 'h1'
        endif
      -%}
      <{{ htag }} class="tf-portada__titulo">{{ section.settings.titulo | remove: '<p>' | remove: '</p>' }}</{{ htag }}>
      {%- if section.settings.sub != blank -%}<p class="tf-portada__sub">{{ section.settings.sub }}</p>{%- endif -%}
      {%- if p != blank and section.settings.btn_texto != blank -%}
        <a class="hl-btn hl-btn--curcuma tf-portada__btn" href="{{ p.url }}">
          <span>{{ section.settings.btn_texto }}{% if section.settings.btn_precio %} · {{ v.price | money_without_trailing_zeros }}{% endif %}</span> {% render 'hl-icono', nombre: 'flecha' %}
        </a>
      {%- endif -%}
      <p class="tf-portada__corte">{% render 'tf-corte' %}</p>
      {%- if section.settings.paises != blank -%}
        <div class="tf-portada__paises">
          <span>{{ section.settings.paises_texto }}</span>
          {%- assign lista = section.settings.paises | split: ',' -%}
          {%- for c in lista -%}{%- assign cod = c | strip | split: ':' -%}
            <span class="tf-portada__pais"><img src="{{ 'tf-bandera-' | append: cod[0] | append: '.png' | asset_url }}" alt="" width="20" height="20" decoding="async" fetchpriority="low">{{ cod[1] }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.frase != blank -%}
        <p class="tf-portada__frase">
          <img class="tf-avatar" src="{{ 'tf-avatar.jpg' | asset_url }}" alt="" width="40" height="40" decoding="async">
          <span>“{{ section.settings.frase }}” <small>{{ section.settings.frase_firma }}</small></span>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Toffee – Temporada",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Temporada: personaje + producto en uso + problema de la temporada + un solo botón. Cambia la temporada aquí (y su fecha en Configuración del tema → Toffee – Fechas y garantía)." },
    { "type": "checkbox", "id": "es_h1", "label": "Título principal de la página (H1)", "info": "Actívalo solo si esta sección es la primera de la página.", "default": false },
    { "type": "text", "id": "ancla", "label": "Ancla", "default": "temporada" },
    { "type": "product", "id": "producto", "label": "Producto de la temporada" },
    { "type": "image_picker", "id": "imagen", "label": "Foto del producto en uso (cuadrada)" },
    { "type": "checkbox", "id": "escena_ia", "label": "La foto es una escena creada con IA", "default": true },
    { "type": "text", "id": "sello", "label": "Sello", "default": "Aprobado por Toffee" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Temporada de pólvora 🎆" },
    { "type": "richtext", "id": "titulo", "label": "Título: el problema en palabras del cliente (cursiva = caramelo)", "default": "<p>Que la pólvora no le arruine diciembre <em>a tu perro</em></p>" },
    { "type": "textarea", "id": "sub", "label": "Texto" },
    { "type": "text", "id": "btn_texto", "label": "Botón", "default": "Ver las orejeras" },
    { "type": "checkbox", "id": "btn_precio", "label": "Mostrar el precio en el botón", "default": true },
    { "type": "text", "id": "paises_texto", "label": "Texto antes de las banderas", "default": "Enviamos a" },
    { "type": "text", "id": "paises", "label": "Países (código:nombre, separados por coma)", "info": "Banderas en assets: tf-bandera-co, mx, cl, pe, us.", "default": "co:Colombia, mx:México, cl:Chile, pe:Perú, us:Estados Unidos" },
    { "type": "text", "id": "frase", "label": "Frase del personaje" },
    { "type": "text", "id": "frase_firma", "label": "Firma de la frase", "default": "— Toffee, personaje de IA" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título", "min": 32, "max": 80, "step": 2, "unit": "px", "default": 60 }
  ],
  "presets": [{ "name": "Toffee – Temporada" }]
}
{% endschema %}
