    "faq": {
      "type": "vx-faq",
      "settings": {
        "eyebrow": "Preguntas frecuentes",
        "titulo": "Lo que todos preguntan",
        "texto": "¿Te queda alguna duda? Escríbenos y te respondemos.",
        "btn_texto": "Escríbenos"
      },
      "blocks": {
        "pregunta-1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Sirve para mi moto?",
            "respuesta": "Sí. Se conecta a la válvula estándar de motos y carros, y trae un modo especial para moto."
          }
        },
        "pregunta-2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuántas llantas infla con una carga?",
            "respuesta": "Con la batería llena puedes recargar varias llantas de moto. En carros es ideal para ajustar la presión o recuperar una llanta baja; inflar llantas de carro completamente desinfladas consume más batería."
          }
        },
        "pregunta-3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto se demora?",
            "respuesta": "Depende del tamaño de la llanta y de qué tan baja esté. Para ajustar la presión de una llanta de moto bastan unos minutos, sin tener que buscar gasolinera."
          }
        },
        "pregunta-4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Hace ruido?",
            "respuesta": "Es un compresor, así que suena mientras trabaja, igual que cualquier inflador. Lo bueno es que solo tarda unos minutos."
          }
        },
        "pregunta-5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo pago?",
            "respuesta": "Pagas cuando recibes, en efectivo, directamente al transportador. Pago contraentrega a todo Colombia."
          }
        },
        "pregunta-6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo lo cuido?",
            "respuesta": "Cárgalo completamente antes del primer uso y recárgalo cada cierto tiempo aunque no lo uses, para tenerlo listo en una emergencia. En usos largos, déjalo descansar unos minutos para que no se caliente."
          }
        }
      },
