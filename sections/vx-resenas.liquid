{{ 'vx-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vx-scripts.js' | asset_url }}" defer></script>

{%- liquid
  assign total = 0
  assign suma = 0
  for block in section.blocks
    assign total = total | plus: 1
    assign suma = suma | plus: block.settings.estrellas
  endfor
-%}

{%- if total > 0 or request.design_mode -%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--vx-grafito);
  }
  #shopify-section-{{ section.id }} .vx-resenas__cabecera { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .vx-resenas__cabecera h2 { font-size: clamp({{ section.settings.titulo_size | times: 0.55 | round }}px, 6vw, {{ section.settings.titulo_size }}px); }
  #shopify-section-{{ section.id }} .vx-resena__texto { font-size: {{ section.settings.texto_size }}px; }
{% endstyle %}

<section class="vx-section vx-resenas" id="resenas">
  <div class="vx-container">
    <div class="vx-resenas__cabecera">
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow vx-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-reveal" style="--vx-i:1">{{ section.settings.titulo }}</h2>
      {%- if total > 0 and section.settings.mostrar_promedio -%}
        {%- assign promedio = suma | times: 1.0 | divided_by: total | round: 1 -%}
        <div class="vx-resenas__resumen vx-reveal" style="--vx-i:2">
          <span class="vx-lcd">{{ promedio }}</span>
          <span class="vx-estrellas" style="--vx-nota: {{ promedio }}" aria-label="{{ promedio }} de 5"></span>
          <span class="vx-texto-suave">{{ total }} {{ section.settings.texto_contador }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if total == 0 -%}
      <p class="vx-resenas__vacio">Añade reseñas reales de tus clientes con el botón "Agregar reseña" de esta sección. Mientras no haya ninguna, esta sección no se muestra en la tienda.</p>
    {%- else -%}
      <div class="vx-resenas__grid">
        {%- for block in section.blocks -%}
          <article class="vx-resena vx-reveal" style="--vx-i:{{ forloop.index | modulo: 6 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.foto != blank -%}
              <div class="vx-resena__foto"><img src="{{ block.settings.foto | image_url: width: 700 }}" alt="{{ block.settings.foto.alt | default: block.settings.nombre | escape }}" loading="lazy" width="700" height="700"></div>
            {%- endif -%}
            <div class="vx-resena__cuerpo">
              <span class="vx-estrellas" style="--vx-nota: {{ block.settings.estrellas }}" aria-label="{{ block.settings.estrellas }} de 5"></span>
              {%- if block.settings.titulo != blank -%}<h3>{{ block.settings.titulo }}</h3>{%- endif -%}
              <p class="vx-resena__texto">{{ block.settings.texto | newline_to_br }}</p>
              <div class="vx-resena__autor">
                <span class="vx-resena__avatar">{{ block.settings.nombre | slice: 0 }}</span>
                <span><strong>{{ block.settings.nombre }}</strong>{% if block.settings.ciudad != blank %}<small>{{ block.settings.ciudad }}</small>{% endif %}</span>
                {%- if block.settings.verificada -%}<span class="vx-resena__ok">{% render 'vx-icono', nombre: 'check' %}{{ section.settings.texto_verificada }}</span>{%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "VX – Reseñas",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Usa solo reseñas reales de tus clientes. La sección se oculta sola mientras no tenga ninguna." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Reseñas" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Lo que dicen nuestros clientes" },
    { "type": "checkbox", "id": "mostrar_promedio", "label": "Mostrar nota media", "default": true },
    { "type": "text", "id": "texto_contador", "label": "Texto junto al número de reseñas", "default": "reseñas" },
    { "type": "text", "id": "texto_verificada", "label": "Texto de compra verificada", "default": "Compra verificada" },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "alineacion", "label": "Alineación del encabezado", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "center" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 28, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "text", "id": "nombre", "label": "Nombre del cliente" },
        { "type": "text", "id": "ciudad", "label": "Ciudad" },
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "titulo", "label": "Título corto" },
        { "type": "textarea", "id": "texto", "label": "Reseña" },
        { "type": "image_picker", "id": "foto", "label": "Foto del cliente (opcional)" },
        { "type": "checkbox", "id": "verificada", "label": "Compra verificada", "default": true }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [ { "name": "VX – Reseñas" } ]
}
{% endschema %}
