{{ 'vx-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vx-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--vx-grafito);
  }
  #shopify-section-{{ section.id }} .vx-faq__lado h2 { font-size: clamp({{ section.settings.titulo_size | times: 0.55 | round }}px, 6vw, {{ section.settings.titulo_size }}px); }
  #shopify-section-{{ section.id }} .vx-faq__lado { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .vx-faq__lado p { font-size: {{ section.settings.texto_size }}px; }
  #shopify-section-{{ section.id }} .vx-faq__item summary { font-size: {{ section.settings.pregunta_size }}px; }
  #shopify-section-{{ section.id }} .vx-faq__resp { font-size: {{ section.settings.texto_size }}px; }
{% endstyle %}

<section class="vx-section vx-faq">
  <div class="vx-container">
    <div class="vx-faq__grid">
      <div class="vx-faq__lado">
        {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow vx-reveal">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="vx-reveal" style="--vx-i:1">{{ section.settings.titulo }}</h2>
        {%- if section.settings.texto != blank -%}<p class="vx-reveal" style="--vx-i:2">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
        {%- if section.settings.btn_texto != blank -%}
          <a class="vx-btn vx-btn--ghost vx-reveal" style="--vx-i:3" href="{{ section.settings.btn_url | default: '/pages/contact' }}">{% render 'vx-icono', nombre: 'chat' %}{{ section.settings.btn_texto }}</a>
        {%- endif -%}
      </div>
      <div>
        {%- for block in section.blocks -%}
          <details class="vx-faq__item vx-reveal" style="--vx-i:{{ forloop.index }}" {% if forloop.first and section.settings.abrir_primera %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.pregunta }}<span class="vx-faq__mas" aria-hidden="true"></span></summary>
            <div class="vx-faq__resp">{{ block.settings.respuesta | newline_to_br }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX – Preguntas",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Lo que todos preguntan" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "¿Te queda alguna duda? Escríbenos y te respondemos." },
    { "type": "text", "id": "btn_texto", "label": "Botón – texto", "default": "Escríbenos" },
    { "type": "url", "id": "btn_url", "label": "Botón – enlace (por ejemplo tu WhatsApp)" },
    { "type": "checkbox", "id": "abrir_primera", "label": "Primera pregunta abierta", "default": true },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "alineacion", "label": "Alineación del texto", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 28, "max": 100, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "pregunta_size", "label": "Tamaño de las preguntas (px)", "min": 15, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Sirve para mi moto?" },
        { "type": "textarea", "id": "respuesta", "label": "Respuesta", "default": "Sí." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "VX – Preguntas", "blocks": [ { "type": "pregunta" } ] } ]
}
{% endschema %}
