{{ 'vx-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo }};
  }
  #shopify-section-{{ section.id }} .vx-garantias { background: {{ section.settings.fondo }}; color: {{ section.settings.color_texto }}; }
  #shopify-section-{{ section.id }} .vx-marquee__item { font-size: {{ section.settings.texto_size }}px; }
  #shopify-section-{{ section.id }} .vx-marquee__pista { --vx-vel: {{ section.settings.velocidad }}s; }
{% endstyle %}

<section class="vx-section vx-garantias" aria-label="{{ section.settings.aria | escape }}">
  <div class="vx-marquee">
    <div class="vx-marquee__pista">
      {%- for i in (1..2) -%}
        {%- for n in (1..3) -%}
          {%- for block in section.blocks -%}
            <span class="vx-marquee__item" {% if i == 1 and n == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>{% render 'vx-icono', nombre: block.settings.icono %}{{ block.settings.texto }}</span>
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VX – Garantías",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "aria", "label": "Nombre de la franja (accesibilidad)", "default": "Garantías de compra" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#FFC400" },
    { "type": "color", "id": "color_texto", "label": "Color del texto", "default": "#0E0F11" },
    { "type": "range", "id": "texto_size", "label": "Tamaño del texto (px)", "min": 14, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "velocidad", "label": "Duración de una vuelta (segundos; más = más lento)", "min": 10, "max": 90, "step": 5, "default": 40 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "options": [
          { "value": "efectivo", "label": "Efectivo" }, { "value": "camion", "label": "Envío" }, { "value": "escudo", "label": "Garantía" },
          { "value": "chat", "label": "Chat" }, { "value": "rayo", "label": "Rayo" }, { "value": "reloj", "label": "Reloj" }, { "value": "check", "label": "Check" }
        ], "default": "check" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Pago contraentrega" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "VX – Garantías", "blocks": [ { "type": "item" } ] } ]
}
{% endschema %}
