  "faq": {
   "type": "zc-faq",
   "blocks": {
    "b0": {
     "type": "pregunta",
     "settings": {
      "pregunta": "¿Cómo pago?",
      "respuesta": "<p>En efectivo cuando el pedido llega a tu casa. No pagas nada por adelantado.</p>"
     }
    },
    "b1": {
     "type": "pregunta",
     "settings": {
      "pregunta": "¿Cuánto se demora en llegar?",
      "respuesta": "<p>Despachamos en 24 horas. En Medellín y el Valle de Aburrá llega en 1 a 2 días hábiles; al resto de Colombia, en 2 a 5 días hábiles.</p>"
     }
    },
    "b2": {
     "type": "pregunta",
     "settings": {
      "pregunta": "¿Sirve para hombres y mujeres?",
      "respuesta": "<p>Sí, es para todos. Lo puedes usar en axilas, manos y pies.</p>"
     }
    },
    "b3": {
     "type": "pregunta",
     "settings": {
      "pregunta": "¿Puedo usarlo con mi desodorante?",
      "respuesta": "<p>Sí. Aplica Body Zero, deja secar y luego tu desodorante si quieres.</p>"
     }
    },
    "b4": {
     "type": "pregunta",
     "settings": {
      "pregunta": "¿Cuánto contenido trae?",
      "respuesta": "<p>Cada frasco trae 120 ml, que rinde muchas aplicaciones.</p>"
     }
    },
    "b5": {
     "type": "pregunta",
     "settings": {
      "pregunta": "¿Tiene alguna precaución?",
      "respuesta": "<p>Es de uso externo. No lo apliques sobre piel irritada, con heridas o quemaduras de sol, y evita el contacto con ojos y mucosas.</p>"
     }
    }
   },
